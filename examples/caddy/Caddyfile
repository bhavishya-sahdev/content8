yourproject.com {
    # auto-blog — /blog and /api/blog route to the blog service
    handle /blog* {
        reverse_proxy auto-blog:3000
    }

    handle /api/blog* {
        reverse_proxy auto-blog:3000
    }

    # Everything else goes to your main app
    handle {
        reverse_proxy main-app:3000
    }
}
