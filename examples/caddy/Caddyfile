yourproject.com {
    # content8 — /blog and /api/blog route to the blog service
    handle /blog* {
        reverse_proxy content8:3000
    }

    handle /api/blog* {
        reverse_proxy content8:3000
    }

    # Static assets. Use the embedded integration for a Next.js main app.
    handle /_next/* {
        reverse_proxy content8:3000
    }

    # Everything else goes to your main app
    handle {
        reverse_proxy main-app:3000
    }
}
